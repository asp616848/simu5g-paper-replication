+static double frac(double x) { return x - std::floor(x); }
+
+std::pair<bool, double> StochasticChannelModel::indoorState(MacNodeId ueId) const
+{
+    // low-discrepancy sequences, offset per run: the fraction of indoor UEs is (almost) exact
+    // and the indoor distance uniform in [0, 25) m, with no state to keep or synchronize
+    double off = frac(getEnvir()->getConfigEx()->getActiveRunNumber() * 0.3247179572447460);
+    double u1 = frac(num(ueId) * 0.6180339887498949 + off);
+    double u2 = frac(num(ueId) * 0.7548776662466927 + 2.0 * off);
+    return { u1 < indoorFraction_, 25.0 * u2 };
+}
+
+double StochasticChannelModel::penetrationLoss(MacNodeId ueId) const
+{
+    if (indoorFraction_ < 0)
+        return 0.0;
+    auto st = indoorState(ueId);
+    // TR 36.873 clause 7.2.3: 20 dB through the external wall + 0.5 dB/m inside
+    return st.first ? 20.0 + 0.5 * st.second : 0.0;
+}
